+     */
+    fun shouldDeliverLocally(recipients: TakRecipients): Boolean {
+        if (recipients.isBroadcast) return true
+        val uids = localUids.load()
+        val callsigns = localCallsigns.load()
+        // Local ATAK hasn't identified itself yet — can't judge, keep stock behaviour.
+        if (uids.isEmpty() && callsigns.isEmpty()) return true
+        if (recipients.uids.any { it in uids } || recipients.callsigns.any { it in callsigns }) return true
+        // ATAK named the recipients explicitly (<marti>) and we're not among them.
+        if (recipients.callsigns.isNotEmpty()) return false
+        // A DM to an ATAK user we know is someone else.
+        val peers = peerByUid.load()
+        if (recipients.uids.any { it in peers }) return false
+        // Unknown room/group id (team chat, custom group): keep stock behaviour.
+        return true
+    }
+
+    /**
+     * The single mesh node every addressee is behind, or null to broadcast. Null when any addressee is unknown or
+     * stale, when they span more than one node, or when the only node is our own.
+     */
+    /** Mesh nodes a TAK client's own traffic (PLI or chat) was heard from within the peer TTL. */
+    fun clientNodes(): Set<Int> {
+        val cutoff = now() - peerTtl
+        return peerByUid.load().values.filter { it.seenAt >= cutoff }.mapTo(mutableSetOf()) { it.node }
+    }
+
+    fun unicastTargetFor(recipients: TakRecipients, ownNode: Int?): Int? {
+        if (recipients.isBroadcast) return null
+        val cutoff = now() - peerTtl
+        val byUid = peerByUid.load()
+        val byCallsign = peerByCallsign.load()
+        val nodes = mutableSetOf<Int>()
+        for (uid in recipients.uids) nodes += byUid[uid]?.takeIf { it.seenAt >= cutoff }?.node ?: return null
+        for (cs in recipients.callsigns) nodes += byCallsign[cs]?.takeIf { it.seenAt >= cutoff }?.node ?: return null
+        val node = nodes.singleOrNull() ?: return null
+        return node.takeIf { it != ownNode }
+    }
+
+    private fun isSelfPli(data: TakPacketV2Data): Boolean {
+        val payloadIsPli = data.payload is TakPacketV2Data.Payload.Pli || data.payload is TakPacketV2Data.Payload.None
+        val type = data.cotTypeStr ?: CotTypeMapper.typeToString(data.cotTypeId)
+        return payloadIsPli && type != null && type.startsWith(FRIENDLY_GROUND_PREFIX) && data.callsign.isNotEmpty()
+    }
+
+    companion object {
+        val DEFAULT_PEER_TTL: Duration = 30.minutes
+        const val DEFAULT_MAX_PEERS: Int = 256
+        private const val GEOCHAT_PREFIX = "GeoChat."
+        private const val GEOCHAT_UID_PARTS = 4
+        private const val FRIENDLY_GROUND_PREFIX = "a-f-G"
+        private const val NODENUM_BROADCAST = -1 // 0xFFFFFFFF as a signed Int
+
+        // CAS loop; compareAndSet compares by identity, which is what we want for the loaded snapshot.
+        private inline fun <T> AtomicReference<T>.mutate(transform: (T) -> T) {
+            while (true) {
+                val current = load()
+                if (compareAndSet(current, transform(current))) return
+            }
+        }
+
+        private fun <K, V> Map<K, V>.withEntry(key: K, value: V, cap: Int): Map<K, V> {
+            val m = LinkedHashMap(this)
+            m.remove(key) // re-insert so the most recently seen entry is last
+            m[key] = value
+            while (m.size > cap) m.remove(m.keys.first())
+            return m
+        }
+    }
+}
