+        assertTrue(xml.contains("<link relation='p-p' uid='MESHTASTIC-0000BEEF' type='a-f-G-U-C'/>"), xml)
+    }
+
+    @Test
+    fun `node uid helper matches Node cotUid`() {
+        assertEquals("MESHTASTIC-A1B2C3D4", meshNodeCotUid(0xa1b2c3d4.toInt()))
+        assertEquals("MESHTASTIC-0000BEEF", meshNodeCotUid(0xbeef))
+    }
+
+    // ── Broadcaster integration ─────────────────────────────────────────────
+
+    private class Harness(val scope: TestScope, now: () -> Instant) {
+        val serverManager = FakeTAKServerManager()
+        val nodeRepository = FakeNodeRepository()
+        val takPrefs = FakeTakPrefs()
+        private val dispatcher = UnconfinedTestDispatcher(scope.testScheduler)
+        val broadcaster =
+            MeshToCotBroadcaster(
+                takServerManager = serverManager,
+                nodeRepository = nodeRepository,
+                takPrefs = takPrefs,
+                dispatchers = CoroutineDispatchers(io = dispatcher, main = dispatcher, default = dispatcher),
+                now = now,
+            )
+
+        init {
+            serverManager.connections.value = 1
+            takPrefs.isMeshToCotEnabled.value = true
+        }
+
+        fun settle() {
+            scope.advanceTimeBy(1_000L)
+            scope.runCurrent()
+        }
+    }
+
+    @Test
+    fun `only selected radios are published`() = runTest {
+        val h = Harness(this) { clock }
+        h.takPrefs.meshToCotOnlySelected.value = true
+        h.takPrefs.meshToCotShownNodes.value = setOf(RELAY)
+        h.nodeRepository.setNodes(listOf(radio(DOG), radio(RELAY)))
+
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+
+        assertEquals(listOf(meshNodeCotUid(RELAY)), h.serverManager.broadcasts.map { it.uid })
+    }
+
+    @Test
+    fun `hiding a radio deletes its marker from the map`() = runTest {
+        val h = Harness(this) { clock }
+        h.nodeRepository.setNodes(listOf(radio(DOG), radio(RELAY)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+        assertEquals(2, h.serverManager.broadcasts.size)
+
+        h.takPrefs.meshToCotShownNodes.value = setOf(RELAY)
+        h.takPrefs.meshToCotOnlySelected.value = true
+        h.settle()
+
+        val deletes = h.serverManager.rawBroadcasts.filter { it.contains("t-x-d-d") }
+        assertEquals(1, deletes.size, "${h.serverManager.rawBroadcasts}")
+        assertTrue(deletes.single().contains("uid='${meshNodeCotUid(DOG)}'"))
+    }
+
+    @Test
+    fun `a radio that gains a TAK client is removed in radios-without-client mode`() = runTest {
+        val h = Harness(this) { clock }
+        h.takPrefs.meshToCotRadioMode.value = MeshToCotRadioMode.CLIENTS_AND_RADIOS_WITHOUT_CLIENT
+        h.nodeRepository.setNodes(listOf(radio(DOG), radio(RELAY)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+        assertEquals(2, h.serverManager.broadcasts.size)
+
+        h.broadcaster.setTakClientNodes(setOf(RELAY))
+        h.settle()
+
+        val deletes = h.serverManager.rawBroadcasts.filter { it.contains("t-x-d-d") }
+        assertEquals(1, deletes.size, "${h.serverManager.rawBroadcasts}")
+        assertTrue(deletes.single().contains("uid='${meshNodeCotUid(RELAY)}'"))
+    }
+
+    @Test
+    fun `a radio not heard within the max age is deleted from the map`() = runTest {
+        val h = Harness(this) { clock }
+        h.takPrefs.meshToCotMaxAgeMinutes.value = 30
+        h.nodeRepository.setNodes(listOf(radio(DOG), radio(RELAY)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+        assertEquals(2, h.serverManager.broadcasts.size)
+
+        // 31 minutes later DOG has been heard again, RELAY has not.
+        clock += 31.minutes
+        h.nodeRepository.setNodes(listOf(radio(DOG, heardAt = clock), radio(RELAY, heardAt = clock - 31.minutes)))
+        h.settle()
+
+        val deletes = h.serverManager.rawBroadcasts.filter { it.contains("t-x-d-d") }
+        assertEquals(1, deletes.size, "${h.serverManager.rawBroadcasts}")
+        assertTrue(deletes.single().contains("uid='${meshNodeCotUid(RELAY)}'"))
+    }
+
+    @Test
+    fun `a trail radio drops crumbs as it moves`() = runTest {
+        val h = Harness(this) { clock }
+        h.takPrefs.breadcrumbNodes.value = setOf(DOG)
+        h.nodeRepository.setNodes(listOf(radio(DOG)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+
+        clock += 61.seconds
+        h.nodeRepository.setNodes(listOf(radio(DOG, latitudeI = LAT + 2000)))
+        h.settle()
+
+        val crumbs = h.serverManager.rawBroadcasts.filter { it.contains("b-m-p-s-m") && !it.contains("t-x-d-d") }
+        assertEquals(2, crumbs.size, "${h.serverManager.rawBroadcasts}")
+    }
+
+    @Test
+    fun `crumbs are recorded without a client and replayed on connect`() = runTest {
+        val h = Harness(this) { clock }
+        h.serverManager.connections.value = 0
+        h.takPrefs.breadcrumbNodes.value = setOf(DOG)
+        h.nodeRepository.setNodes(listOf(radio(DOG)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+        assertTrue(h.serverManager.rawBroadcasts.isEmpty())
+
+        h.serverManager.connections.value = 1
+        h.serverManager.emitClientConnected()
+        h.settle()
+
+        assertEquals(1, h.serverManager.rawBroadcasts.count { it.contains("b-m-p-s-m") })
+    }
+
+    @Test
+    fun `turning a trail off deletes its crumbs`() = runTest {
+        val h = Harness(this) { clock }
+        h.takPrefs.breadcrumbNodes.value = setOf(DOG)
+        h.nodeRepository.setNodes(listOf(radio(DOG)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+
+        h.takPrefs.breadcrumbNodes.value = emptySet()
+        h.settle()
+
+        assertTrue(h.serverManager.rawBroadcasts.any { it.contains("t-x-d-d") && it.contains("-trail-") })
+    }
+
+    private fun radio(num: Int, latitudeI: Int = LAT, heardAt: Instant = clock) = Node(
+        num = num,
+        user =
+        org.meshtastic.proto.User(
+            id = "!" + num.toUInt().toString(16).padStart(8, '0'),
+            short_name = "R${num and 0xff}",
+            long_name = "Radio $num",
+            hw_model = org.meshtastic.proto.HardwareModel.TBEAM,
+        ),
+        position = org.meshtastic.proto.Position(latitude_i = latitudeI, longitude_i = LON),
+        lastHeard = heardAt.epochSeconds.toInt(),
+    )
+
+    private companion object {
+        const val DOG = 0x0000d06d
+        const val RELAY = 0x0000beef
+        const val LAT = 377_749_000
+        const val LON = -1_224_194_000
+
+    }
+}
