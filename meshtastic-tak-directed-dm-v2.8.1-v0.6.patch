+import kotlin.time.Duration.Companion.seconds
+import kotlin.time.Instant
+
+class MeshBreadcrumbsTest {
+
+    private var clock = Instant.fromEpochSeconds(1_800_000_000)
+    private val settings = BreadcrumbSettings(interval = 60.seconds, keepFor = 6.hours, colorArgb = -65536)
+
+    // ── Selection ───────────────────────────────────────────────────────────
+
+    @Test
+    fun `all radios are shown unless only-selected is on`() {
+        assertTrue(MeshToCotSelection().isShown(DOG))
+        val selected = MeshToCotSelection(onlySelected = true, shownNodes = setOf(RELAY))
+        assertTrue(selected.isShown(RELAY))
+        assertFalse(selected.isShown(DOG))
+    }
+
+    @Test
+    fun `a radio with a trail is always shown`() {
+        val selection = MeshToCotSelection(onlySelected = true, shownNodes = emptySet(), trailNodes = setOf(DOG))
+        assertTrue(selection.isShown(DOG))
+        assertTrue(selection.hasTrail(DOG))
+    }
+
+    @Test
+    fun `clients only hides every radio except trail radios`() {
+        val selection = MeshToCotSelection(mode = MeshToCotRadioMode.CLIENTS_ONLY, trailNodes = setOf(DOG))
+        assertFalse(selection.isShown(RELAY))
+        assertTrue(selection.isShown(DOG))
+    }
+
+    @Test
+    fun `radios without a client hides radios that carry a TAK client`() {
+        val selection =
+            MeshToCotSelection(mode = MeshToCotRadioMode.CLIENTS_AND_RADIOS_WITHOUT_CLIENT, clientNodes = setOf(RELAY))
+        assertFalse(selection.isShown(RELAY), "radio carrying an ATAK user is hidden")
+        assertTrue(selection.isShown(DOG), "standalone tracker is shown")
+    }
+
+    @Test
+    fun `mode and picker combine`() {
+        val selection =
+            MeshToCotSelection(
+                mode = MeshToCotRadioMode.CLIENTS_AND_RADIOS_WITHOUT_CLIENT,
+                onlySelected = true,
+                shownNodes = setOf(DOG, RELAY),
+                clientNodes = setOf(RELAY),
+            )
+        assertTrue(selection.isShown(DOG))
+        assertFalse(selection.isShown(RELAY))
+        assertFalse(selection.isShown(0x1234), "not picked")
+    }
+
+    // ── Trail ───────────────────────────────────────────────────────────────
+
+    @Test
+    fun `first position drops a crumb immediately`() {
+        val trail = BreadcrumbTrail { clock }
+        assertNotNull(trail.maybeDrop(DOG, "DOG - Rex", LAT, LON, settings))
+    }
+
+    @Test
+    fun `no crumb before the interval even if moved`() {
+        val trail = BreadcrumbTrail { clock }
+        trail.maybeDrop(DOG, "DOG", LAT, LON, settings)
+        clock += 30.seconds
+        assertNull(trail.maybeDrop(DOG, "DOG", LAT + 1000, LON, settings))
+    }
+
+    @Test
+    fun `a parked radio does not stack crumbs`() {
+        val trail = BreadcrumbTrail { clock }
+        trail.maybeDrop(DOG, "DOG", LAT, LON, settings)
+        clock += 10.minutes
+        assertNull(trail.maybeDrop(DOG, "DOG", LAT, LON, settings))
+    }
+
+    @Test
+    fun `moved after the interval drops a new crumb with a unique uid`() {
+        val trail = BreadcrumbTrail { clock }
+        val first = trail.maybeDrop(DOG, "DOG", LAT, LON, settings)!!
+        clock += 61.seconds
+        val second = trail.maybeDrop(DOG, "DOG", LAT + 1000, LON, settings)!!
+        assertTrue(first.uid != second.uid)
+        assertEquals(2, trail.all().size)
+    }
+
+    @Test
+    fun `crumbs expire after the keep time`() {
+        val trail = BreadcrumbTrail { clock }
+        trail.maybeDrop(DOG, "DOG", LAT, LON, settings)
+        clock += 7.hours
+        trail.expire(settings.keepFor)
+        assertTrue(trail.all().isEmpty())
+        assertTrue(trail.nodes().isEmpty())
+    }
+
+    @Test
+    fun `removing a radio returns its crumbs`() {
+        val trail = BreadcrumbTrail { clock }
+        trail.maybeDrop(DOG, "DOG", LAT, LON, settings)
+        trail.maybeDrop(RELAY, "RLY", LAT, LON, settings)
+        assertEquals(1, trail.removeNode(DOG).size)
+        assertEquals(setOf(RELAY), trail.nodes())
+    }
+
+    @Test
+    fun `crumb xml is a coloured spot marker that goes stale at the keep time`() {
+        val trail = BreadcrumbTrail { clock }
+        val xml = trail.maybeDrop(DOG, "DOG - Rex", LAT, LON, settings)!!.xml
+        assertTrue(xml.contains("type='b-m-p-s-m'"), xml)
+        assertTrue(xml.contains("<color argb='-65536'/>"), xml)
+        assertTrue(xml.contains("COT_MAPPING_SPOTMAP/b-m-p-s-m/-65536"), xml)
+        assertTrue(xml.contains("stale='2027-01-15T14:00:00.000Z'"), xml)
+        assertTrue(xml.contains("callsign='DOG "), "label is the short name plus time: $xml")
+        assertTrue(xml.contains("uid='${meshNodeCotUid(DOG)}'"), "links back to the radio: $xml")
+        assertFalse(xml.contains("<?xml"), "CoT stream events must not carry an XML declaration")
+    }
+
+    @Test
+    fun `delete xml targets the given uid`() {
