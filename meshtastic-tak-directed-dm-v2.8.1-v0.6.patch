+
+// ── Mesh to CoT radio picker + breadcrumb trail settings ────────────────────
+// Which radios appear on the TAK map, and which ones leave a trail of spot-map dots.
+
+private val RADIO_MODE_OPTIONS =
+    listOf(
+        MeshToCotRadioMode.RADIOS_AND_CLIENTS to "Radios + clients",
+        MeshToCotRadioMode.CLIENTS_ONLY to "Clients only",
+        MeshToCotRadioMode.CLIENTS_AND_RADIOS_WITHOUT_CLIENT to "Clients + radios without a client",
+    )
+
+private fun radioModeSummary(mode: MeshToCotRadioMode): String = when (mode) {
+    MeshToCotRadioMode.RADIOS_AND_CLIENTS -> "Every radio marker, plus TAK users"
+    MeshToCotRadioMode.CLIENTS_ONLY -> "Only TAK users; no radio markers (trail radios still show)"
+    MeshToCotRadioMode.CLIENTS_AND_RADIOS_WITHOUT_CLIENT ->
+        "TAK users, plus radios nobody's TAK client is on (e.g. a tracker)"
+}
+
+private val MAX_AGE_OPTIONS =
+    listOf(10 to "10 minutes", 15 to "15 minutes", 30 to "30 minutes", 60 to "1 hour", 120 to "2 hours")
+
+private val TRAIL_INTERVAL_OPTIONS =
+    listOf(30 to "30 seconds", 60 to "1 minute", 120 to "2 minutes", 300 to "5 minutes", 600 to "10 minutes")
+
+private val TRAIL_KEEP_OPTIONS =
+    listOf(60 to "1 hour", 180 to "3 hours", 360 to "6 hours", 720 to "12 hours", 1440 to "24 hours")
+
+// ATAK spot-map colours as signed ARGB ints (ATAK's own encoding, e.g. red = -65536).
+private val TRAIL_COLOR_OPTIONS =
+    listOf(
+        0xFFFF0000.toInt() to "Red",
+        0xFFFFFF00.toInt() to "Yellow",
+        0xFFFF7F00.toInt() to "Orange",
+        0xFFFF00FF.toInt() to "Magenta",
+        0xFF00FFFF.toInt() to "Cyan",
+        0xFFFFFFFF.toInt() to "White",
+    )
+
+/** Keeps a dropdown valid when the saved value isn't one of the presets. */
+private fun <T> List<Pair<T, String>>.withCurrent(current: T): List<Pair<T, String>> =
+    if (any { it.first == current }) this else this + (current to current.toString())
+
+@Composable
+internal fun MeshToCotRadiosCard() {
+    val takPrefs: TakPrefs = koinInject()
+    val nodeRepository: NodeRepository = koinInject()
+    val radioMode by takPrefs.meshToCotRadioMode.collectAsStateWithLifecycle()
+    val onlySelected by takPrefs.meshToCotOnlySelected.collectAsStateWithLifecycle()
+    val maxAgeMinutes by takPrefs.meshToCotMaxAgeMinutes.collectAsStateWithLifecycle()
+    val shown by takPrefs.meshToCotShownNodes.collectAsStateWithLifecycle()
+    val trailNodes by takPrefs.breadcrumbNodes.collectAsStateWithLifecycle()
+    val interval by takPrefs.breadcrumbIntervalSeconds.collectAsStateWithLifecycle()
+    val keepMinutes by takPrefs.breadcrumbKeepMinutes.collectAsStateWithLifecycle()
+    val color by takPrefs.breadcrumbColorArgb.collectAsStateWithLifecycle()
+    val nodesByNum by nodeRepository.nodeDBbyNum.collectAsStateWithLifecycle()
+    val myNodeInfo by nodeRepository.myNodeInfo.collectAsStateWithLifecycle()
+    var showPicker by remember { mutableStateOf(false) }
+
+    val ourNum = myNodeInfo?.myNodeNum
+    val radios =
+        nodesByNum.values
+            .filter { it.num != ourNum && !it.isUnknownUser }
+            .sortedBy { radioName(it).lowercase() }
+
+    TitledCard(title = "Mesh to CoT radios") {
+        DropDownPreference(
+            title = "Show on map",
+            summary = radioModeSummary(radioMode),
+            enabled = true,
+            items = RADIO_MODE_OPTIONS,
+            selectedItem = radioMode,
+            onItemSelected = { takPrefs.setMeshToCotRadioMode(it) },
+        )
+        HorizontalDivider()
+        DropDownPreference(
+            title = "Remove radios not heard for",
+            summary = "Their marker is deleted from the TAK map; it comes back when the radio is heard again",
+            enabled = true,
+            items = MAX_AGE_OPTIONS.withCurrent(maxAgeMinutes),
+            selectedItem = maxAgeMinutes,
+            onItemSelected = { takPrefs.setMeshToCotMaxAgeMinutes(it) },
+        )
+        HorizontalDivider()
+        SwitchPreference(
+            title = "Only show selected radios",
+            summary = if (onlySelected) "Only radios you pick appear on the TAK map" else "All radios appear on the TAK map",
+            checked = onlySelected,
+            enabled = true,
+            onCheckedChange = { takPrefs.setMeshToCotOnlySelected(it) },
+        )
+        HorizontalDivider()
+        Column(modifier = Modifier.fillMaxWidth().clickable { showPicker = true }.padding(16.dp)) {
+            Text(text = "Choose radios", style = MaterialTheme.typography.bodyLarge)
+            Text(
+                text = "${shown.size} picked to show · ${trailNodes.size} with a breadcrumb trail",
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+        HorizontalDivider()
+        DropDownPreference(
+            title = "Trail: drop a dot every",
+            summary = "Only when the radio has moved since its last dot",
+            enabled = true,
+            items = TRAIL_INTERVAL_OPTIONS.withCurrent(interval),
+            selectedItem = interval,
+            onItemSelected = { takPrefs.setBreadcrumbIntervalSeconds(it) },
+        )
+        HorizontalDivider()
+        DropDownPreference(
+            title = "Trail: keep dots for",
+            enabled = true,
+            items = TRAIL_KEEP_OPTIONS.withCurrent(keepMinutes),
+            selectedItem = keepMinutes,
+            onItemSelected = { takPrefs.setBreadcrumbKeepMinutes(it) },
+        )
+        HorizontalDivider()
+        DropDownPreference(
+            title = "Trail: dot colour",
+            enabled = true,
+            items = TRAIL_COLOR_OPTIONS.withCurrent(color),
+            selectedItem = color,
+            onItemSelected = { takPrefs.setBreadcrumbColorArgb(it) },
+        )
+    }
+
+    if (showPicker) {
+        RadioPickerDialog(
+            radios = radios,
+            shown = shown,
+            trailNodes = trailNodes,
+            onShownChange = { num, on -> takPrefs.setMeshToCotShownNodes(if (on) shown + num else shown - num) },
+            onTrailChange = { num, on -> takPrefs.setBreadcrumbNodes(if (on) trailNodes + num else trailNodes - num) },
+            onDismiss = { showPicker = false },
+        )
+    }
+}
+
+private fun radioName(node: Node): String {
+    val long = node.user.long_name.trim()
+    val short = node.user.short_name.trim()
+    return when {
+        long.isNotEmpty() -> long
+        short.isNotEmpty() -> short
+        else -> "!" + node.num.toUInt().toString(16).padStart(8, '0')
+    }
+}
+
+@Composable
+private fun RadioPickerDialog(
+    radios: List<Node>,
+    shown: Set<Int>,
+    trailNodes: Set<Int>,
+    onShownChange: (Int, Boolean) -> Unit,
+    onTrailChange: (Int, Boolean) -> Unit,
+    onDismiss: () -> Unit,
+) {
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        confirmButton = { TextButton(onClick = onDismiss) { Text("Done") } },
+        title = { Text("Choose radios") },
+        text = {
+            Column {
+                Text(
+                    text = "Show: put this radio on the TAK map (used when \"Only show selected radios\" is on). " +
+                        "Trail: drop a breadcrumb dot as it moves (always shown).",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+                Row(modifier = Modifier.fillMaxWidth().padding(top = 12.dp), verticalAlignment = Alignment.CenterVertically) {
+                    Text("Radio", modifier = Modifier.weight(1f), style = MaterialTheme.typography.labelLarge)
+                    Text("Show", modifier = Modifier.width(56.dp), textAlign = TextAlign.Center, style = MaterialTheme.typography.labelLarge)
+                    Text("Trail", modifier = Modifier.width(56.dp), textAlign = TextAlign.Center, style = MaterialTheme.typography.labelLarge)
+                }
+                HorizontalDivider()
+                if (radios.isEmpty()) {
+                    Text(
+                        text = "No radios heard yet. Connect to your radio and wait for the node list to fill in.",
+                        modifier = Modifier.padding(vertical = 12.dp),
+                        style = MaterialTheme.typography.bodyMedium,
+                    )
+                }
+                LazyColumn(modifier = Modifier.heightIn(max = 420.dp)) {
+                    items(radios, key = { it.num }) { node ->
+                        val hasTrail = node.num in trailNodes
+                        Row(modifier = Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+                            Column(modifier = Modifier.weight(1f).padding(vertical = 6.dp)) {
+                                Text(
+                                    text = radioName(node),
+                                    style = MaterialTheme.typography.bodyLarge,
+                                    maxLines = 1,
+                                    overflow = TextOverflow.Ellipsis,
+                                )
+                                val detail =
+                                    buildString {
+                                        append(node.user.short_name.trim())
+                                        if (node.validPosition == null) append(" · no position yet")
+                                    }
+                                Text(
+                                    text = detail,
+                                    style = MaterialTheme.typography.bodySmall,
+                                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                                )
+                            }
+                            Checkbox(
+                                checked = node.num in shown || hasTrail,
+                                enabled = !hasTrail,
+                                onCheckedChange = { onShownChange(node.num, it) },
+                                modifier = Modifier.width(56.dp),
+                            )
+                            Checkbox(
+                                checked = hasTrail,
+                                onCheckedChange = { onTrailChange(node.num, it) },
+                                modifier = Modifier.width(56.dp),
+                            )
+                        }
+                    }
+                }
+            }
+        },
+    )
+}
