+    fun `stale peer mapping falls back to broadcast`() {
+        val r = router()
+        r.learnPeer(nodeA, pli("ANDROID-a", "ALPHA"))
+        clock += 31.minutes
+        assertNull(r.unicastTargetFor(TakRecipients.of(dm("ANDROID-me", "ANDROID-a", "ALPHA")), nodeMe))
+    }
+
+    @Test
+    fun `recipients on two different nodes stay broadcast`() {
+        val r = router()
+        r.learnPeer(nodeA, pli("ANDROID-a", "ALPHA"))
+        r.learnPeer(nodeB, pli("ANDROID-b", "BRAVO"))
+        val group = TakRecipients(uids = setOf("team-room"), callsigns = setOf("ALPHA", "BRAVO"))
+        assertNull(r.unicastTargetFor(group, nodeMe))
+    }
+
+    @Test
+    fun `peer that moved radios is unicast to the newest node`() {
+        val r = router()
+        r.learnPeer(nodeA, pli("ANDROID-a", "ALPHA"))
+        r.learnPeer(nodeB, pli("ANDROID-a", "ALPHA"))
+        assertEquals(nodeB, r.unicastTargetFor(TakRecipients.of(dm("ANDROID-me", "ANDROID-a", "ALPHA")), nodeMe))
+    }
+
+    @Test
+    fun `never unicast to our own node`() {
+        val r = router()
+        r.learnPeer(nodeMe, pli("ANDROID-a", "ALPHA"))
+        assertNull(r.unicastTargetFor(TakRecipients.of(dm("ANDROID-x", "ANDROID-a", "ALPHA")), nodeMe))
+    }
+
+    @Test
+    fun `peer learned from GeoChat sender uid`() {
+        val r = router()
+        r.learnPeer(nodeA, dm("ANDROID-a", "ANDROID-me", "ME"))
+        assertEquals(nodeA, r.unicastTargetFor(TakRecipients(setOf("ANDROID-a"), emptySet()), nodeMe))
+    }
+
+    @Test
+    fun `DM addressed to me is delivered`() {
+        val r = router()
+        r.learnLocal("ANDROID-me", "ME")
+        assertTrue(r.shouldDeliverLocally(TakRecipients.of(dm("ANDROID-a", "ANDROID-me", "ME"))))
+    }
+
+    @Test
+    fun `DM addressed to someone else by marti is dropped`() {
+        val r = router()
+        r.learnLocal("ANDROID-me", "ME")
+        assertFalse(r.shouldDeliverLocally(TakRecipients.of(dm("ANDROID-a", "ANDROID-b", "BRAVO"))))
+    }
+
+    @Test
+    fun `DM to known other peer without marti is dropped`() {
+        val r = router()
+        r.learnLocal("ANDROID-me", "ME")
+        r.learnPeer(nodeB, pli("ANDROID-b", "BRAVO"))
+        assertFalse(r.shouldDeliverLocally(TakRecipients.of(dm("ANDROID-a", "ANDROID-b", null))))
+    }
+
+    @Test
+    fun `unknown room without marti is delivered as stock behaviour`() {
+        val r = router()
+        r.learnLocal("ANDROID-me", "ME")
+        assertTrue(r.shouldDeliverLocally(TakRecipients(setOf("Cyan"), emptySet())))
+    }
+
+    @Test
+    fun `group message listing me in marti is delivered`() {
+        val r = router()
+        r.learnLocal("ANDROID-me", "ME")
+        assertTrue(r.shouldDeliverLocally(TakRecipients(setOf("team-room"), setOf("ALPHA", "ME"))))
+    }
+
+    @Test
+    fun `everything delivered before local ATAK identifies itself`() {
+        val r = router()
+        assertTrue(r.shouldDeliverLocally(TakRecipients.of(dm("ANDROID-a", "ANDROID-b", "BRAVO"))))
+    }
+
+    @Test
+    fun `broadcast traffic always delivered`() {
+        val r = router()
+        r.learnLocal("ANDROID-me", "ME")
+        assertTrue(r.shouldDeliverLocally(TakRecipients.of(allChat("ANDROID-a"))))
+        assertTrue(r.shouldDeliverLocally(TakRecipients.of(pli("ANDROID-a", "ALPHA"))))
+    }
+
+    @Test
+    fun `client nodes are radios a TAK client was heard from recently`() {
+        val r = router()
+        r.learnPeer(nodeA, pli("ANDROID-a", "ALPHA"))
+        r.learnPeer(nodeB, dm("ANDROID-b", "ANDROID-a", "ALPHA"))
+        assertEquals(setOf(nodeA, nodeB), r.clientNodes())
+        clock += 31.minutes
+        assertTrue(r.clientNodes().isEmpty(), "stale clients drop out")
+    }
+
+    @Test
+    fun `peer table is bounded`() {
+        val r = TakDirectedRouter(maxPeers = 2, now = { clock })
+        r.learnPeer(nodeA, pli("u1", "C1"))
+        r.learnPeer(nodeA, pli("u2", "C2"))
+        r.learnPeer(nodeB, pli("u3", "C3"))
+        assertNull(r.unicastTargetFor(TakRecipients(setOf("u1"), emptySet()), nodeMe), "oldest evicted")
+        assertEquals(nodeB, r.unicastTargetFor(TakRecipients(setOf("u3"), emptySet()), nodeMe))
+    }
+}
