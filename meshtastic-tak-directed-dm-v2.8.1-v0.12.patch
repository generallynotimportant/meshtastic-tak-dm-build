+package org.meshtastic.core.takserver
+
+import kotlinx.datetime.TimeZone
+import kotlinx.datetime.toLocalDateTime
+import org.meshtastic.core.repository.MeshToCotRadioMode
+import kotlin.math.PI
+import kotlin.math.asin
+import kotlin.math.cos
+import kotlin.math.sin
+import kotlin.math.sqrt
+import kotlin.random.Random
+import kotlin.time.Duration
+import kotlin.time.Duration.Companion.seconds
+import kotlin.time.Instant
+
+/** The stable CoT UID for mesh node [num], e.g. `MESHTASTIC-A1B2C3D4`. See [org.meshtastic.core.model.Node.cotUid]. */
+internal fun meshNodeCotUid(num: Int): String =
+    MESH_NODE_UID_PREFIX + num.toUInt().toString(TAK_HEX_RADIX).uppercase().padStart(MESH_NODE_UID_HEX_WIDTH, '0')
+
+/**
+ * Which radios Mesh-to-CoT puts on the TAK map.
+ *
+ * [mode] decides first (all radios / none / only radios without a TAK client, using [clientNodes] — radios a TAK
+ * client's traffic was recently heard from), then the [onlySelected] picker narrows it further. A radio with a
+ * breadcrumb trail is always shown — a trail of a radio you can't see is not useful.
+ */
+internal data class MeshToCotSelection(
+    val onlySelected: Boolean = false,
+    val shownNodes: Set<Int> = emptySet(),
+    val trailNodes: Set<Int> = emptySet(),
+    val mode: MeshToCotRadioMode = MeshToCotRadioMode.RADIOS_AND_CLIENTS,
+    val clientNodes: Set<Int> = emptySet(),
+) {
+    fun isShown(num: Int): Boolean {
+        if (num in trailNodes) return true
+        val modeAllows =
+            when (mode) {
+                MeshToCotRadioMode.RADIOS_AND_CLIENTS -> true
+                MeshToCotRadioMode.CLIENTS_ONLY -> false
+                MeshToCotRadioMode.CLIENTS_AND_RADIOS_WITHOUT_CLIENT -> num !in clientNodes
+            }
+        return modeAllows && (!onlySelected || num in shownNodes)
+    }
+
+    fun hasTrail(num: Int): Boolean = num in trailNodes
+}
+
+/**
+ * Breadcrumb trail settings. [keepForever] marks dots as saved (`<archive/>`, like a spot marker the user placed) so
+ * the TAK client keeps them; [keepFor] is then just a far-off stale time.
+ */
+internal data class BreadcrumbSettings(
+    val interval: Duration,
+    val keepFor: Duration,
+    val colorArgb: Int,
+    val minDistanceMeters: Int = 0,
+    val keepForever: Boolean = false,
+)
+
+/** One dropped breadcrumb: a spot-map dot at a radio's position at a point in time. */
+internal data class Breadcrumb(
+    val nodeNum: Int,
+    val uid: String,
+    val latitudeI: Int,
+    val longitudeI: Int,
+    val droppedAt: Instant,
+    val xml: String,
+)
+
+/**
+ * Remembers the breadcrumbs dropped for each radio so they can be replayed to a newly connected TAK client, removed
+ * from the map when a trail is turned off, and forgotten once they expire.
+ *
+ * A breadcrumb is dropped only when the radio has moved since its last one AND at least [BreadcrumbSettings.interval]
+ * has passed, so a parked radio doesn't stack dots on one spot. Not thread-safe; callers serialize access.
+ */
+internal class BreadcrumbTrail(private val now: () -> Instant) {
+    private val crumbs = mutableMapOf<Int, ArrayDeque<Breadcrumb>>()
+
+    /**
+     * Drops a breadcrumb for [nodeNum] at the given position when due, returning it (null when not due). The trail is
+     * capped so a short interval with a long keep time can't grow without bound.
+     */
+    @Suppress("LongParameterList")
+    fun maybeDrop(
+        nodeNum: Int,
+        callsign: String,
+        latitudeI: Int,
+        longitudeI: Int,
+        settings: BreadcrumbSettings,
+        signal: String? = null,
+    ): Breadcrumb? {
+        val at = now()
+        val trail = crumbs.getOrPut(nodeNum) { ArrayDeque() }
+        val last = trail.lastOrNull()
+        if (last != null) {
+            val moved = last.latitudeI != latitudeI || last.longitudeI != longitudeI
+            if (!moved || at - last.droppedAt < settings.interval) return null
+            // Filters GPS jitter: a radio lying still wanders a few metres between fixes.
+            if (distanceMeters(last.latitudeI, last.longitudeI, latitudeI, longitudeI) < settings.minDistanceMeters) {
+                return null
+            }
+        }
+        val uid = "${meshNodeCotUid(nodeNum)}-trail-${at.epochSeconds}-${Random.nextInt(0, RANDOM_SUFFIX_BOUND)}"
+        val crumb =
+            Breadcrumb(
+                nodeNum = nodeNum,
+                uid = uid,
+                latitudeI = latitudeI,
+                longitudeI = longitudeI,
+                droppedAt = at,
+                xml = breadcrumbCotXml(uid, nodeNum, callsign, latitudeI, longitudeI, at, settings, signal),
+            )
+        trail.addLast(crumb)
+        while (trail.size > MAX_CRUMBS_PER_NODE) trail.removeFirst()
+        return crumb
+    }
+
+    /** Forgets breadcrumbs older than [keepFor]; ATAK has already dropped them via their stale time. */
+    fun expire(keepFor: Duration) {
+        val cutoff = now() - keepFor
+        crumbs.values.forEach { trail -> while (trail.firstOrNull()?.let { it.droppedAt < cutoff } == true) trail.removeFirst() }
+        crumbs.entries.removeAll { it.value.isEmpty() }
+    }
+
+    /** Removes and returns every breadcrumb of [nodeNum] (to delete them from the TAK map). */
+    fun removeNode(nodeNum: Int): List<Breadcrumb> = crumbs.remove(nodeNum)?.toList() ?: emptyList()
+
+    /** Node numbers that currently have breadcrumbs. */
+    fun nodes(): Set<Int> = crumbs.filterValues { it.isNotEmpty() }.keys.toSet()
+
+    /** Every live breadcrumb, oldest first per radio (for replay to a new TAK client). */
+    fun all(): List<Breadcrumb> = crumbs.values.flatMap { it.toList() }
+
+    companion object {
+        /** Hard cap per radio: one day at a 30-second interval. */
+        const val MAX_CRUMBS_PER_NODE = 2_880
+        private const val RANDOM_SUFFIX_BOUND = 1_000_000
+    }
+}
+
+/**
+ * A spot-map dot (CoT `b-m-p-s-m`, same shape ATAK itself emits — see the SDK's `marker_spot.xml` fixture) labelled
+ * with the radio's short name and the local time it was there. It expires on its own after the keep time, unless
+ * [BreadcrumbSettings.keepForever] marks it saved. [signal] (SNR / hops when the dot dropped) goes in the details.
+ */
+@Suppress("LongParameterList")
+internal fun breadcrumbCotXml(
+    uid: String,
+    nodeNum: Int,
+    callsign: String,
+    latitudeI: Int,
+    longitudeI: Int,
+    at: Instant,
+    settings: BreadcrumbSettings,
+    signal: String? = null,
+): String {
+    val lat = latitudeI.toDouble() / TAK_COORDINATE_SCALE
+    val lon = longitudeI.toDouble() / TAK_COORDINATE_SCALE
+    val hhmm = localHhMm(at)
+    val remarks = listOfNotNull("Breadcrumb: $callsign at $hhmm", signal?.takeIf { it.isNotEmpty() }).joinToString(" | ")
+    val archive = if (settings.keepForever) "<archive/>" else ""
+    val label = "${callsign.substringBefore(" - ").trim().ifEmpty { callsign }} $hhmm"
+    val time = at.toCotTime()
+    val stale = (at + settings.keepFor).toCotTime()
+    val color = settings.colorArgb
+    return "<event version='2.0' uid='${uid.xmlEscaped()}' type='b-m-p-s-m' time='$time' start='$time' " +
+        "stale='$stale' how='h-g-i-g-o'><point lat='$lat' lon='$lon' hae='9999999.0' ce='9999999.0' " +
+        "le='9999999.0'/><detail><status readiness='true'/>$archive" +
+        "<link uid='${meshNodeCotUid(nodeNum).xmlEscaped()}' type='$MESH_NODE_COT_TYPE' relation='p-p'/>" +
+        "<contact callsign='${label.xmlEscaped()}'/>" +
+        "<remarks>${remarks.xmlEscaped()}</remarks>" +
+        "<color argb='$color'/><usericon iconsetpath='COT_MAPPING_SPOTMAP/b-m-p-s-m/$color'/></detail></event>"
+}
+
+/**
+ * A CoT delete (`t-x-d-d`) telling TAK clients to remove the map item [targetUid] — same shape as the SDK's
+ * `delete_event.xml` fixture, captured from a real TAK server.
+ */
+internal fun deleteCotXml(targetUid: String, targetType: String, at: Instant): String {
+    val time = at.toCotTime()
+    val stale = (at + DELETE_EVENT_STALE).toCotTime()
+    val uid = "delete-${targetUid}-${at.toEpochMilliseconds()}"
+    return "<event version='2.0' uid='${uid.xmlEscaped()}' type='t-x-d-d' how='h-g-i-g-o' time='$time' " +
+        "start='$time' stale='$stale'><point lat='0' lon='0' hae='0' ce='9999999' le='9999999'/><detail>" +
+        "<link relation='p-p' uid='${targetUid.xmlEscaped()}' type='${targetType.xmlEscaped()}'/></detail></event>"
+}
+
+private val DELETE_EVENT_STALE: Duration = 20.seconds
+
+/** Local wall-clock `HH:MM` for labels and details. */
+internal fun localHhMm(at: Instant): String {
+    val local = at.toLocalDateTime(TimeZone.currentSystemDefault())
