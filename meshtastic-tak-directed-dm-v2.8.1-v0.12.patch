+package org.meshtastic.core.takserver
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertTrue
+
+class PrefXmlDeclarationTest {
+    @Test
+    fun `pref declares XML 1_0 so WinTAK can parse it`() {
+        val pref = TAKDataPackageGenerator.generateConfigPref()
+        assertTrue(pref.startsWith("<?xml version='1.0' encoding='UTF-8' standalone='yes'?>\n<"), pref)
+        assertEquals(1, Regex("""<\?xml""").findAll(pref).count(), "exactly one declaration: $pref")
+        assertTrue(!pref.contains("'1.1'") && !pref.contains("\"1.1\""), pref)
+    }
+
+    @Test
+    fun `plain TCP pref declares XML 1_0 too`() {
+        val pref = TAKDataPackageGenerator.generateConfigPref(useTls = false)
+        assertTrue(pref.startsWith("<?xml version='1.0'"), pref)
+    }
+
+    @Test
+    fun `ATAK cert paths are unchanged`() {
+        val pref = TAKDataPackageGenerator.generateConfigPref()
+        assertTrue(pref.contains(">cert/truststore.p12<"), pref)
+        assertTrue(pref.contains(">cert/client.p12<"), pref)
+    }
+}
