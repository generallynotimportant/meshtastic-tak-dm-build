+import kotlin.test.assertTrue
+import kotlin.time.Duration.Companion.hours
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.Duration.Companion.seconds
+import kotlin.time.Instant
+
+class MeshBreadcrumbsTest {
+
+    private var clock = Instant.fromEpochSeconds(1_800_000_000)
+    private val settings = BreadcrumbSettings(interval = 60.seconds, keepFor = 6.hours, colorArgb = -65536)
+
+    // ── Selection ───────────────────────────────────────────────────────────
+
+    @Test
+    fun `all radios are shown unless only-selected is on`() {
+        assertTrue(MeshToCotSelection().isShown(DOG))
+        val selected = MeshToCotSelection(onlySelected = true, shownNodes = setOf(RELAY))
+        assertTrue(selected.isShown(RELAY))
+        assertFalse(selected.isShown(DOG))
+    }
+
+    @Test
+    fun `a radio with a trail is always shown`() {
+        val selection = MeshToCotSelection(onlySelected = true, shownNodes = emptySet(), trailNodes = setOf(DOG))
+        assertTrue(selection.isShown(DOG))
+        assertTrue(selection.hasTrail(DOG))
+    }
+
+    @Test
+    fun `clients only hides every radio except trail radios`() {
+        val selection = MeshToCotSelection(mode = MeshToCotRadioMode.CLIENTS_ONLY, trailNodes = setOf(DOG))
+        assertFalse(selection.isShown(RELAY))
+        assertTrue(selection.isShown(DOG))
+    }
+
+    @Test
+    fun `radios without a client hides radios that carry a TAK client`() {
+        val selection =
+            MeshToCotSelection(mode = MeshToCotRadioMode.CLIENTS_AND_RADIOS_WITHOUT_CLIENT, clientNodes = setOf(RELAY))
+        assertFalse(selection.isShown(RELAY), "radio carrying an ATAK user is hidden")
+        assertTrue(selection.isShown(DOG), "standalone tracker is shown")
+    }
+
+    @Test
+    fun `mode and picker combine`() {
+        val selection =
+            MeshToCotSelection(
+                mode = MeshToCotRadioMode.CLIENTS_AND_RADIOS_WITHOUT_CLIENT,
+                onlySelected = true,
+                shownNodes = setOf(DOG, RELAY),
+                clientNodes = setOf(RELAY),
+            )
+        assertTrue(selection.isShown(DOG))
+        assertFalse(selection.isShown(RELAY))
+        assertFalse(selection.isShown(0x1234), "not picked")
+    }
+
+    // ── Trail ───────────────────────────────────────────────────────────────
+
+    @Test
+    fun `first position drops a crumb immediately`() {
+        val trail = BreadcrumbTrail { clock }
+        assertNotNull(trail.maybeDrop(DOG, "DOG - Rex", LAT, LON, settings))
+    }
+
+    @Test
+    fun `no crumb before the interval even if moved`() {
+        val trail = BreadcrumbTrail { clock }
+        trail.maybeDrop(DOG, "DOG", LAT, LON, settings)
+        clock += 30.seconds
+        assertNull(trail.maybeDrop(DOG, "DOG", LAT + 1000, LON, settings))
+    }
+
+    @Test
+    fun `a parked radio does not stack crumbs`() {
+        val trail = BreadcrumbTrail { clock }
+        trail.maybeDrop(DOG, "DOG", LAT, LON, settings)
+        clock += 10.minutes
+        assertNull(trail.maybeDrop(DOG, "DOG", LAT, LON, settings))
+    }
+
+    @Test
+    fun `moved after the interval drops a new crumb with a unique uid`() {
+        val trail = BreadcrumbTrail { clock }
+        val first = trail.maybeDrop(DOG, "DOG", LAT, LON, settings)!!
+        clock += 61.seconds
+        val second = trail.maybeDrop(DOG, "DOG", LAT + 1000, LON, settings)!!
+        assertTrue(first.uid != second.uid)
+        assertEquals(2, trail.all().size)
+    }
+
+    @Test
+    fun `crumbs expire after the keep time`() {
+        val trail = BreadcrumbTrail { clock }
+        trail.maybeDrop(DOG, "DOG", LAT, LON, settings)
+        clock += 7.hours
+        trail.expire(settings.keepFor)
+        assertTrue(trail.all().isEmpty())
+        assertTrue(trail.nodes().isEmpty())
+    }
+
+    @Test
+    fun `removing a radio returns its crumbs`() {
+        val trail = BreadcrumbTrail { clock }
+        trail.maybeDrop(DOG, "DOG", LAT, LON, settings)
+        trail.maybeDrop(RELAY, "RLY", LAT, LON, settings)
+        assertEquals(1, trail.removeNode(DOG).size)
+        assertEquals(setOf(RELAY), trail.nodes())
+    }
+
+    @Test
+    fun `crumb xml is a coloured spot marker that goes stale at the keep time`() {
+        val trail = BreadcrumbTrail { clock }
+        val xml = trail.maybeDrop(DOG, "DOG - Rex", LAT, LON, settings)!!.xml
+        assertTrue(xml.contains("type='b-m-p-s-m'"), xml)
+        assertTrue(xml.contains("<color argb='-65536'/>"), xml)
+        assertTrue(xml.contains("COT_MAPPING_SPOTMAP/b-m-p-s-m/-65536"), xml)
+        assertTrue(xml.contains("stale='2027-01-15T14:00:00.000Z'"), xml)
+        assertTrue(xml.contains("callsign='DOG "), "label is the short name plus time: $xml")
+        assertTrue(xml.contains("uid='${meshNodeCotUid(DOG)}'"), "links back to the radio: $xml")
+        assertFalse(xml.contains("<?xml"), "CoT stream events must not carry an XML declaration")
+    }
+
+    @Test
+    fun `delete xml targets the given uid`() {
+        val xml = deleteCotXml("MESHTASTIC-0000BEEF", "a-f-G-U-C", clock)
+        assertTrue(xml.contains("type='t-x-d-d'"), xml)
+        assertTrue(xml.contains("<link relation='p-p' uid='MESHTASTIC-0000BEEF' type='a-f-G-U-C'/>"), xml)
+    }
+
+    @Test
+    fun `node uid helper matches Node cotUid`() {
+        assertEquals("MESHTASTIC-A1B2C3D4", meshNodeCotUid(0xa1b2c3d4.toInt()))
+        assertEquals("MESHTASTIC-0000BEEF", meshNodeCotUid(0xbeef))
+    }
+
+    @Test
+    fun `no crumb until the radio has moved the minimum distance`() {
+        val trail = BreadcrumbTrail { clock }
+        val tenMetres = settings.copy(minDistanceMeters = 10)
+        trail.maybeDrop(DOG, "DOG", LAT, LON, tenMetres)
+        clock += 2.minutes
+        assertNull(trail.maybeDrop(DOG, "DOG", LAT + 300, LON, tenMetres), "~3 m of jitter is ignored")
+        assertNotNull(trail.maybeDrop(DOG, "DOG", LAT + 1500, LON, tenMetres), "~17 m is a real move")
+    }
+
+    @Test
+    fun `distance helper is roughly right`() {
+        // 0.001 degrees of latitude is about 111 m.
+        val d = distanceMeters(LAT, LON, LAT + 10_000, LON)
+        assertTrue(d in 105.0..117.0, "got $d")
+    }
+
+    @Test
+    fun `keep forever saves the dot and signal goes in the details`() {
+        val trail = BreadcrumbTrail { clock }
+        val forever = settings.copy(keepForever = true)
+        val xml = trail.maybeDrop(DOG, "DOG", LAT, LON, forever, signal = "SNR: 6.5 dB | Hops: 1")!!.xml
+        assertTrue(xml.contains("<archive/>"), xml)
+        assertTrue(xml.contains("SNR: 6.5 dB | Hops: 1"), xml)
+        assertFalse(trail.maybeDrop(RELAY, "RLY", LAT, LON, settings)!!.xml.contains("<archive/>"))
+    }
+
+    @Test
+    fun `quiet TAK users expire`() {
+        val users = TakUserExpiry({ clock })
+        users.heard("ANDROID-a", "a-f-G-U-C")
+        clock += 10.minutes
+        users.heard("ANDROID-b", "a-f-G-U-C")
+        clock += 25.minutes
+        assertEquals(listOf("ANDROID-a" to "a-f-G-U-C"), users.expire(30.minutes))
+        assertTrue(users.expire(30.minutes).isEmpty(), "already removed")
+    }
+
+    @Test
+    fun `port in use gets a plain-language reason`() {
+        val reason = describeStartFailure(IllegalStateException("bind failed", RuntimeException("Address already in use")))
+        assertTrue(reason!!.contains("Port 8089 is already in use"), reason)
+        assertNull(describeStartFailure(null))
+    }
+
+    @Test
+    fun `radio details include last heard and hops`() {
+        val remarks = radio(DOG).copy(hopsAway = 2).toCoTMessage().remarks!!
+        assertTrue(remarks.startsWith("Last heard: "), remarks)
+        assertTrue(remarks.contains("Hops: 2"), remarks)
+    }
+
+    // ── Broadcaster integration ─────────────────────────────────────────────
+
+    private class Harness(val scope: TestScope, now: () -> Instant) {
+        val serverManager = FakeTAKServerManager()
+        val nodeRepository = FakeNodeRepository()
+        val takPrefs = FakeTakPrefs()
+        private val dispatcher = UnconfinedTestDispatcher(scope.testScheduler)
+        val broadcaster =
+            MeshToCotBroadcaster(
+                takServerManager = serverManager,
+                nodeRepository = nodeRepository,
+                takPrefs = takPrefs,
+                dispatchers = CoroutineDispatchers(io = dispatcher, main = dispatcher, default = dispatcher),
+                now = now,
+            )
+
+        init {
+            serverManager.connections.value = 1
+            takPrefs.isMeshToCotEnabled.value = true
+        }
+
+        fun settle() {
+            scope.advanceTimeBy(1_000L)
+            scope.runCurrent()
+        }
+    }
+
+    @Test
+    fun `only selected radios are published`() = runTest {
+        val h = Harness(this) { clock }
+        h.takPrefs.meshToCotOnlySelected.value = true
+        h.takPrefs.meshToCotShownNodes.value = setOf(RELAY)
+        h.nodeRepository.setNodes(listOf(radio(DOG), radio(RELAY)))
+
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+
+        assertEquals(listOf(meshNodeCotUid(RELAY)), h.serverManager.broadcasts.map { it.uid })
+    }
+
+    @Test
+    fun `hiding a radio deletes its marker from the map`() = runTest {
+        val h = Harness(this) { clock }
+        h.nodeRepository.setNodes(listOf(radio(DOG), radio(RELAY)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+        assertEquals(2, h.serverManager.broadcasts.size)
+
+        h.takPrefs.meshToCotShownNodes.value = setOf(RELAY)
+        h.takPrefs.meshToCotOnlySelected.value = true
+        h.settle()
+
+        val deletes = h.serverManager.rawBroadcasts.filter { it.contains("t-x-d-d") }
+        assertEquals(1, deletes.size, "${h.serverManager.rawBroadcasts}")
+        assertTrue(deletes.single().contains("uid='${meshNodeCotUid(DOG)}'"))
+    }
+
+    @Test
+    fun `a radio that gains a TAK client is removed in radios-without-client mode`() = runTest {
+        val h = Harness(this) { clock }
+        h.takPrefs.meshToCotRadioMode.value = MeshToCotRadioMode.CLIENTS_AND_RADIOS_WITHOUT_CLIENT
+        h.nodeRepository.setNodes(listOf(radio(DOG), radio(RELAY)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+        assertEquals(2, h.serverManager.broadcasts.size)
+
+        h.broadcaster.setTakClientNodes(setOf(RELAY))
+        h.settle()
+
+        val deletes = h.serverManager.rawBroadcasts.filter { it.contains("t-x-d-d") }
+        assertEquals(1, deletes.size, "${h.serverManager.rawBroadcasts}")
+        assertTrue(deletes.single().contains("uid='${meshNodeCotUid(RELAY)}'"))
+    }
+
+    @Test
+    fun `a radio not heard within the max age is deleted from the map`() = runTest {
+        val h = Harness(this) { clock }
+        h.takPrefs.meshToCotMaxAgeMinutes.value = 30
+        h.nodeRepository.setNodes(listOf(radio(DOG), radio(RELAY)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+        assertEquals(2, h.serverManager.broadcasts.size)
+
+        // 31 minutes later DOG has been heard again, RELAY has not.
+        clock += 31.minutes
+        h.nodeRepository.setNodes(listOf(radio(DOG, heardAt = clock), radio(RELAY, heardAt = clock - 31.minutes)))
+        h.settle()
+
+        val deletes = h.serverManager.rawBroadcasts.filter { it.contains("t-x-d-d") }
+        assertEquals(1, deletes.size, "${h.serverManager.rawBroadcasts}")
+        assertTrue(deletes.single().contains("uid='${meshNodeCotUid(RELAY)}'"))
+    }
+
+    @Test
+    fun `leftover markers for our own and hidden radios are deleted on enable`() = runTest {
+        val h = Harness(this) { clock }
+        h.nodeRepository.setMyNodeInfo(myNodeInfo(OURS))
+        h.takPrefs.meshToCotRadioMode.value = MeshToCotRadioMode.CLIENTS_ONLY
+        h.nodeRepository.setNodes(listOf(radio(OURS), radio(RELAY)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+
+        val deleted = h.serverManager.rawBroadcasts.filter { it.contains("t-x-d-d") }
+        assertTrue(deleted.any { it.contains("uid='${meshNodeCotUid(OURS)}'") }, "own radio: $deleted")
+        assertTrue(deleted.any { it.contains("uid='${meshNodeCotUid(RELAY)}'") }, "hidden radio: $deleted")
+        assertTrue(h.serverManager.broadcasts.isEmpty(), "clients only publishes no radio markers")
+    }
+
+    @Test
+    fun `a saved 30 second interval acts as one minute`() = runTest {
+        val h = Harness(this) { clock }
+        h.takPrefs.breadcrumbIntervalSeconds.value = 30
+        h.takPrefs.breadcrumbNodes.value = setOf(DOG)
+        h.nodeRepository.setNodes(listOf(radio(DOG)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+
+        clock += 31.seconds
+        h.nodeRepository.setNodes(listOf(radio(DOG, latitudeI = LAT + 2000)))
+        h.settle()
+        assertEquals(1, h.serverManager.rawBroadcasts.count { it.contains("b-m-p-s-m") }, "no dot before a minute")
+
+        clock += 30.seconds
+        h.nodeRepository.setNodes(listOf(radio(DOG, latitudeI = LAT + 4000)))
+        h.settle()
+        assertEquals(2, h.serverManager.rawBroadcasts.count { it.contains("b-m-p-s-m") })
+    }
+
+    @Test
+    fun `a trail radio drops crumbs as it moves`() = runTest {
+        val h = Harness(this) { clock }
+        h.takPrefs.breadcrumbNodes.value = setOf(DOG)
+        h.nodeRepository.setNodes(listOf(radio(DOG)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+
+        clock += 61.seconds
+        h.nodeRepository.setNodes(listOf(radio(DOG, latitudeI = LAT + 2000)))
+        h.settle()
+
+        val crumbs = h.serverManager.rawBroadcasts.filter { it.contains("b-m-p-s-m") && !it.contains("t-x-d-d") }
+        assertEquals(2, crumbs.size, "${h.serverManager.rawBroadcasts}")
+    }
+
+    @Test
+    fun `crumbs are recorded without a client and replayed on connect`() = runTest {
+        val h = Harness(this) { clock }
+        h.serverManager.connections.value = 0
+        h.takPrefs.breadcrumbNodes.value = setOf(DOG)
+        h.nodeRepository.setNodes(listOf(radio(DOG)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+        assertTrue(h.serverManager.rawBroadcasts.isEmpty())
+
+        h.serverManager.connections.value = 1
+        h.serverManager.emitClientConnected()
+        h.settle()
+
+        assertEquals(1, h.serverManager.rawBroadcasts.count { it.contains("b-m-p-s-m") })
+    }
+
+    @Test
+    fun `turning a trail off deletes its crumbs`() = runTest {
+        val h = Harness(this) { clock }
+        h.takPrefs.breadcrumbNodes.value = setOf(DOG)
+        h.nodeRepository.setNodes(listOf(radio(DOG)))
+        h.broadcaster.start(backgroundScope)
+        h.settle()
+
+        h.takPrefs.breadcrumbNodes.value = emptySet()
+        h.settle()
+
+        assertTrue(h.serverManager.rawBroadcasts.any { it.contains("t-x-d-d") && it.contains("-trail-") })
+    }
+
+    private fun radio(num: Int, latitudeI: Int = LAT, heardAt: Instant = clock) = Node(
+        num = num,
+        user =
+        org.meshtastic.proto.User(
+            id = "!" + num.toUInt().toString(16).padStart(8, '0'),
+            short_name = "R${num and 0xff}",
+            long_name = "Radio $num",
+            hw_model = org.meshtastic.proto.HardwareModel.TBEAM,
+        ),
+        position = org.meshtastic.proto.Position(latitude_i = latitudeI, longitude_i = LON),
+        lastHeard = heardAt.epochSeconds.toInt(),
+    )
+
+    private fun myNodeInfo(num: Int) = org.meshtastic.core.model.MyNodeInfo(
+        myNodeNum = num,
+        hasGPS = false,
+        model = null,
+        firmwareVersion = "2.8.0",
+        couldUpdate = false,
+        shouldUpdate = false,
+        currentPacketId = 1L,
+        messageTimeoutMsec = 5000,
+        minAppVersion = 1,
+        maxChannels = 8,
+        hasWifi = false,
+        channelUtilization = 0f,
+        airUtilTx = 0f,
+        deviceId = null,
+    )
+
+    private companion object {
+        const val DOG = 0x0000d06d
+        const val OURS = 0x00000c0c
+        const val RELAY = 0x0000beef
+        const val LAT = 377_749_000
+        const val LON = -1_224_194_000
+
+    }
+}
