+/**
+ * The addressees of one TAK event, as ATAK expressed them.
+ *
+ * - [uids]: the GeoChat `__chat[@id]` of a direct message (the recipient's ATAK UID). Empty for "All Chat Rooms".
+ * - [callsigns]: the `<marti><dest callsign=…/>` list ATAK attaches to directed traffic (DMs, receipts, TAK-Talk).
+ *
+ * Both empty means the event is for everyone (PLI, All Chat Rooms, markers, …).
+ */
+internal data class TakRecipients(val uids: Set<String>, val callsigns: Set<String>) {
+    val isBroadcast: Boolean
+        get() = uids.isEmpty() && callsigns.isEmpty()
+
+    companion object {
+        private const val ALL_CHAT_ROOMS = "All Chat Rooms"
+
+        fun of(data: TakPacketV2Data): TakRecipients {
+            val chatTo =
+                (data.payload as? TakPacketV2Data.Payload.Chat)?.to?.takeIf { it.isNotEmpty() && it != ALL_CHAT_ROOMS }
+            return TakRecipients(
+                uids = setOfNotNull(chatTo),
+                callsigns = data.marti.filter { it.isNotEmpty() }.toSet(),
+            )
+        }
+    }
+}
+
+/**
+ * Directed routing for TAK traffic over the mesh — the job a real TAK Server does with `<marti>` and that the
+ * phone-local bridge otherwise skips.
+ *
+ * Without it, every GeoChat DM is sent to the mesh broadcast address and every receiving phone hands it to its ATAK,
+ * which files it as a DM — so a message to one person shows up in everyone's DMs.
+ *
+ * Two independent fixes, each enough on its own when it applies:
+ * 1. **Send side** ([unicastTargetFor]): if every addressee maps to one known mesh node, send to that node instead of
+ *    broadcast. Firmware only hands a packet to the phone when it is broadcast or addressed to that node
+ *    (`RoutingModule.cpp`), so other phones never see it — even if they run an unpatched app — and firmware 2.5+
+ *    PKI-encrypts it to the recipient.
+ * 2. **Receive side** ([shouldDeliverLocally]): when a directed event still arrives as a broadcast (unknown recipient,
+ *    group message, oversized, older sender app), drop it unless it is addressed to this phone's ATAK user.
+ *
+ * Both sides fail open: when something is unknown, behaviour is exactly the stock broadcast-to-all.
+ *
+ * Peers (remote ATAK users) are learned from their own TAK traffic arriving off the mesh: the mesh packet's `from` node
+ * plus the PLI uid/callsign or the GeoChat sender uid. Local users are learned from what the local ATAK client sends
+ * us. Entries expire after [peerTtl] so a user who moves to a different radio falls back to broadcast rather than
+ * being unicast to a node they no longer carry.
+ */
+@OptIn(ExperimentalAtomicApi::class)
+internal class TakDirectedRouter(
+    private val peerTtl: Duration = DEFAULT_PEER_TTL,
+    private val maxPeers: Int = DEFAULT_MAX_PEERS,
+    private val now: () -> Instant = { Clock.System.now() },
+) {
+    private data class PeerEntry(val node: Int, val seenAt: Instant)
+
+    // Copy-on-write maps behind atomic references: written from the mesh collector, read from the TAK-client
+    // collector. Kotlin's default Map is insertion-ordered, which the eviction in [withEntry] relies on.
+    private val peerByUid = AtomicReference(emptyMap<String, PeerEntry>())
+    private val peerByCallsign = AtomicReference(emptyMap<String, PeerEntry>())
+    private val localUids = AtomicReference(emptySet<String>())
+    private val localCallsigns = AtomicReference(emptySet<String>())
+
+    /** Record an identity of an ATAK client connected to this phone's TAK server. */
+    fun learnLocal(uid: String?, callsign: String?) {
+        uid?.takeIf { it.isNotEmpty() && !it.startsWith(GEOCHAT_PREFIX) }?.let { u -> localUids.mutate { it + u } }
+        callsign?.takeIf { it.isNotEmpty() }?.let { c -> localCallsigns.mutate { it + c } }
+    }
+
+    /** Record which mesh node a remote ATAK user is behind, from a TAK packet that node originated. */
+    fun learnPeer(fromNode: Int, data: TakPacketV2Data) {
+        if (fromNode == 0 || fromNode == NODENUM_BROADCAST) return
+        val uid: String
+        val callsign: String
+        when {
+            // GeoChat event uid is GeoChat.<senderUid>.<chatroom>.<messageId>
+            data.uid.startsWith(GEOCHAT_PREFIX) -> {
+                uid = data.uid.split(".", limit = GEOCHAT_UID_PARTS).getOrNull(1) ?: return
+                callsign = (data.payload as? TakPacketV2Data.Payload.Chat)?.toCallsign ?: data.callsign
+            }
+            // Self-reported position (PLI) of a friendly ground EUD: event uid is the device uid.
+            isSelfPli(data) -> {
+                uid = data.uid
+                callsign = data.callsign
+            }
+            else -> return
+        }
+        if (uid.isEmpty()) return
+        val entry = PeerEntry(fromNode, now())
+        peerByUid.mutate { it.withEntry(uid, entry, maxPeers) }
+        callsign.takeIf { it.isNotEmpty() }?.let { cs -> peerByCallsign.mutate { it.withEntry(cs, entry, maxPeers) } }
+    }
+
+    /**
+     * Should an event that arrived from the mesh be handed to this phone's ATAK?
+     *
+     * Only returns false when we are confident it is addressed to someone else.
+     */
+    fun shouldDeliverLocally(recipients: TakRecipients): Boolean {
+        if (recipients.isBroadcast) return true
+        val uids = localUids.load()
+        val callsigns = localCallsigns.load()
+        // Local ATAK hasn't identified itself yet — can't judge, keep stock behaviour.
+        if (uids.isEmpty() && callsigns.isEmpty()) return true
+        if (recipients.uids.any { it in uids } || recipients.callsigns.any { it in callsigns }) return true
+        // ATAK named the recipients explicitly (<marti>) and we're not among them.
+        if (recipients.callsigns.isNotEmpty()) return false
+        // A DM to an ATAK user we know is someone else.
+        val peers = peerByUid.load()
+        if (recipients.uids.any { it in peers }) return false
+        // Unknown room/group id (team chat, custom group): keep stock behaviour.
+        return true
+    }
+
+    /**
+     * The single mesh node every addressee is behind, or null to broadcast. Null when any addressee is unknown or
+     * stale, when they span more than one node, or when the only node is our own.
+     */
+    /** Mesh nodes a TAK client's own traffic (PLI or chat) was heard from within the peer TTL. */
+    fun clientNodes(): Set<Int> {
+        val cutoff = now() - peerTtl
+        return peerByUid.load().values.filter { it.seenAt >= cutoff }.mapTo(mutableSetOf()) { it.node }
+    }
+
+    fun unicastTargetFor(recipients: TakRecipients, ownNode: Int?): Int? {
+        if (recipients.isBroadcast) return null
+        val cutoff = now() - peerTtl
+        val byUid = peerByUid.load()
+        val byCallsign = peerByCallsign.load()
+        val nodes = mutableSetOf<Int>()
+        for (uid in recipients.uids) nodes += byUid[uid]?.takeIf { it.seenAt >= cutoff }?.node ?: return null
+        for (cs in recipients.callsigns) nodes += byCallsign[cs]?.takeIf { it.seenAt >= cutoff }?.node ?: return null
+        val node = nodes.singleOrNull() ?: return null
+        return node.takeIf { it != ownNode }
+    }
+
+    /** True for a friendly ground EUD's own position report (event uid = device uid). */
+    fun isSelfPli(data: TakPacketV2Data): Boolean {
+        val payloadIsPli = data.payload is TakPacketV2Data.Payload.Pli || data.payload is TakPacketV2Data.Payload.None
+        val type = data.cotTypeStr ?: CotTypeMapper.typeToString(data.cotTypeId)
+        return payloadIsPli && type != null && type.startsWith(FRIENDLY_GROUND_PREFIX) && data.callsign.isNotEmpty()
+    }
+
+    companion object {
+        val DEFAULT_PEER_TTL: Duration = 30.minutes
+        const val DEFAULT_MAX_PEERS: Int = 256
+        private const val GEOCHAT_PREFIX = "GeoChat."
+        private const val GEOCHAT_UID_PARTS = 4
+        private const val FRIENDLY_GROUND_PREFIX = "a-f-G"
+        private const val NODENUM_BROADCAST = -1 // 0xFFFFFFFF as a signed Int
+
+        // CAS loop; compareAndSet compares by identity, which is what we want for the loaded snapshot.
+        private inline fun <T> AtomicReference<T>.mutate(transform: (T) -> T) {
+            while (true) {
+                val current = load()
+                if (compareAndSet(current, transform(current))) return
+            }
+        }
+
+        private fun <K, V> Map<K, V>.withEntry(key: K, value: V, cap: Int): Map<K, V> {
+            val m = LinkedHashMap(this)
+            m.remove(key) // re-insert so the most recently seen entry is last
+            m[key] = value
+            while (m.size > cap) m.remove(m.keys.first())
+            return m
+        }
+    }
+}
