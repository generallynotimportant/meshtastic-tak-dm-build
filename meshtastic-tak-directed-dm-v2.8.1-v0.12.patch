+package org.meshtastic.core.takserver
+
+import kotlin.time.Duration
+import kotlin.time.Instant
+
+/**
+ * Remembers when each remote TAK user's position (PLI) was last heard over the mesh, so their icon can be removed from
+ * the local TAK map once they go quiet instead of lingering greyed-out. Not thread-safe; callers serialize access.
+ */
+internal class TakUserExpiry(private val now: () -> Instant, private val maxUsers: Int = DEFAULT_MAX_USERS) {
+    private data class Seen(val type: String, val at: Instant)
+
+    // Insertion-ordered; re-inserted on every sighting so the oldest entry is first.
+    private val seen = LinkedHashMap<String, Seen>()
+
+    fun heard(uid: String, type: String) {
+        seen.remove(uid)
+        seen[uid] = Seen(type, now())
+        while (seen.size > maxUsers) seen.remove(seen.keys.first())
+    }
+
+    /** Removes and returns (uid, CoT type) of every user not heard within [maxAge]. */
+    fun expire(maxAge: Duration): List<Pair<String, String>> {
+        val cutoff = now() - maxAge
+        val gone = seen.filterValues { it.at < cutoff }
+        gone.keys.forEach { seen.remove(it) }
+        return gone.map { (uid, s) -> uid to s.type }
+    }
+
+    companion object {
+        const val DEFAULT_MAX_USERS = 512
+    }
+}
